# DOMAIN
DOMAIN_ADDRESS=test.local
CSRF_TRUSTED_ORIGINS=http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Django Admin
DJANGO_ENV_FILE=.env.test
DJANGO_ADMIN_USER=admin_test
DJANGO_ADMIN_PASSWORD=testpassword123
DJANGO_ADMIN_EMAIL=test@example.com
DJANGO_DEBUG=True
DJANGO_SECRET_KEY='testsecretkey123456'

# Postgres
POSTGRES_DB=test_db
POSTGRES_USER=test_pguser
POSTGRES_PASSWORD=test_pgpass
POSTGRES_HOST=pg_test
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=test@example.com
PGADMIN_DEFAULT_PASSWORD=test_pgpass

# MinIO
MINIO_ROOT_USER=minio_test
MINIO_ROOT_PASSWORD=minio_pass
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

# Mongo
MONGO_INITDB_ROOT_USERNAME=mongo_test
MONGO_INITDB_ROOT_PASSWORD=mongo_pass
MONGO_DB=test_logs
MONGO_EXPRESS_USER=mongo_express
MONGO_EXPRESS_PASSWORD=express_pass
MONGO_URI=mongodb://mongo_test:27017/test_logs

# MQTT
MQTT_PORT=1883
MQTT_USERNAME=worker_test
MQTT_PASSWORD=worker_pass

# EMQX
EMQX_NAME=test_mqtt
EMQX_NODE__NAME=emqx@test_mqtt
EMQX_NODE__COOKIE=testcookie
EMQX_DASHBOARD__DEFAULT_USERNAME=admin_test
EMQX_DASHBOARD__DEFAULT_PASSWORD=dashboard_pass
API_KEY=user_creation_api_key
API_SECRET=test_api_secret

# Redis
REDIS_PASSWORD=testredispass

# Celery
CELERY_BROKER_URL=redis://:testredispass@redis_test:6379/0
CELERY_RESULT_BACKEND=redis://:testredispass@redis_test:6379/1