# MongoDB
MONGO_INITDB_ROOT_USERNAME=mdm_mongo
MONGO_INITDB_ROOT_PASSWORD=ChangeThisMongoPassword123!
MONGO_DB=mdm_logs
MONGO_URI=mongodb://mdm_mongo:ChangeThisMongoPassword123!@mongodb:27017/mdm_logs?authSource=admin
