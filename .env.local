# Redis and Celery
REDIS_PASSWORD=ChangeThisRedisPassword123!
CELERY_BROKER_URL=redis://:ChangeThisRedisPassword123!@redis:6379/0
CELERY_RESULT_BACKEND=redis://:ChangeThisRedisPassword123!@redis:6379/1

# MinIO
MINIO_ROOT_USER=mdm_minio
MINIO_ROOT_PASSWORD=ChangeThisMinioPassword123!
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

# MQTT worker account
MQTT_HOST=mqtt
MQTT_PORT=1883
